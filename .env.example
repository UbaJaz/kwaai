# Copy to .env and fill in what you need. Never commit .env. Values here are examples or empty on purpose.
NODE_ENV=development
PORT=3000
BASE_URL=
# Sign-in emails: one of these two
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
MODERATORS=
# A secret of at least 32 characters that links reviews to their authors without storing who wrote them. Required in
# production. Keep it in a password manager: if it's lost, old reviews can't be deleted or banned by their author.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTHOR_KEY=
CONTACT_EMAIL=
OPERATOR=
INFORMATION_OFFICER=
EMAIL_DAILY_CAP=
TRUST_PROXY=
DEMO_PASSWORD=
# Admin account: run `npm run admin-hash` and paste the line it prints. Never the password itself.
ADMIN_USERNAME=kwaai
ADMIN_PASSWORD_HASH=
# 1 shows /admin/tools (fake study data for testing). Leave empty at launch.
TEST_TOOLS=
DB_FILE=
BACKUP_DIR=
